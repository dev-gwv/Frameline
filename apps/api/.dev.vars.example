# Copy to .dev.vars for `wrangler dev` (never commit .dev.vars).
# In production set each with: wrangler secret put <NAME> --env production

# ── Required ────────────────────────────────────────────────────────────────
# HS256 key for access/guest/upload tokens and refresh-token hashing. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
# Pepper mixed into OTP code hashes (separate from JWT_SECRET).
OTP_PEPPER=dev-only-otp-pepper-change-me

# ── Email (optional in dev: codes are printed to the wrangler log) ──────────
RESEND_API_KEY=

# ── Google sign-in (optional) ───────────────────────────────────────────────
# Authorised redirect URI: <API_PUBLIC_URL or http://localhost:8787>/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native app redirects allowed for Google sign-in (comma-separated; tokens return in the URL fragment).
GOOGLE_NATIVE_REDIRECTS=frameline://sign-in

# ── Google Drive (optional; docs/GOOGLE_DRIVE_PLAN.md) ──────────────────────
# Uses the Google client above. Add the redirect URI <API_PUBLIC_URL>/v1/drive/callback to it.
# 32 random bytes, base64 (seals stored refresh tokens): node -e "console.log(crypto.randomBytes(32).toString('base64'))"
DRIVE_TOKEN_KEY=
# The Google Picker's browser key (restricted to the Picker API and the admin site) and the Cloud project number.
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=

# ── Direct-to-R2 presigned uploads (optional; without them parts go through the Worker) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Image processor container / service (optional; simulated when empty) ────
PROCESSOR_URL=
PROCESSOR_TOKEN=

# ── Face search: Vectorize has no local simulator. Set to 1 only with remote bindings. ──
VECTORIZE_REMOTE=

# ── Payments (not used by v1 endpoints yet; reserved for checkout + payouts) ─
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Studio AutoPilot (optional) ─────────────────────────────────────────────
# Shared with Studio AutoPilot's server (its FRAMELINE_SECRET): it signs "Open gallery" sign-in links and
# its project-gallery calls with this. 32+ random characters; the same value on both sides. Empty = off.
STUDIOAUTOPILOT_SECRET=
