{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "frameline-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // Deployed at https://frameline-api.<your-subdomain>.workers.dev until a real domain is wired up
  // (see "Going to a real domain" in README.md — swap these vars and add a `routes` entry then).
  "workers_dev": true,

  // Non-secret configuration. Secrets live in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    "ENVIRONMENT": "development",
    "API_VERSION": "1.0.0",
    "BUILD_SHA": "dev",
    "CORS_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:19006",
    "APP_URL": "http://localhost:5173",
    "GALLERY_URL": "http://localhost:5174",
    "MAIL_FROM": "Frameline <login@frameline.in>",
    "R2_BUCKET_NAME": "frameline-media"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frameline",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "frameline-media" }],

  // Every minute: Smart QR schedule switches + due scheduled broadcasts. 03:00 UTC: empty the event trash (30 days).
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] },

  // OAuth state/PKCE verifiers (short TTL).
  "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000000" }],

  "queues": {
    "producers": [{ "binding": "PHOTO_QUEUE", "queue": "frameline-photos" }],
    "consumers": [
      {
        "queue": "frameline-photos",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "frameline-photos-dlq"
      }
    ]
  },

  "durable_objects": {
    "bindings": [
      { "name": "EVENT_HUB", "class_name": "EventHub" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventHub", "RateLimiter"] }],

  // Face embeddings. 128 dimensions matches SFace (see docs/REDESIGN_BRIEF.md's processor plan); if the
  // processor later moves to ArcFace (512-dim), recreate this index — Vectorize can't change dimensions in place.
  "vectorize": [{ "binding": "FACES", "index_name": "frameline-faces" }],

  // Workers Rate Limiting API. Periods can only be 10 or 60 seconds; longer windows use the RateLimiter DO.
  "ratelimits": [
    { "name": "RL_GLOBAL", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],

  "env": {
    "production": {
      "name": "frameline-api",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "production",
        "API_VERSION": "1.0.0",
        "BUILD_SHA": "set-by-ci",
        // Swapped for real origins by CI (see .github/workflows/deploy.yml) once admin/gallery Pages URLs
        // (or a real domain) are known. These defaults keep a manual `wrangler deploy --env production` safe.
        "CORS_ORIGINS": "https://frameline-admin.pages.dev,https://frameline-gallery.pages.dev",
        "APP_URL": "https://frameline-admin.pages.dev",
        "GALLERY_URL": "https://frameline-gallery.pages.dev",
        "MAIL_FROM": "Frameline <login@frameline.in>",
        "R2_BUCKET_NAME": "frameline-media",
        "GOOGLE_NATIVE_REDIRECTS": "frameline://sign-in"
      },
      "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
      "d1_databases": [{ "binding": "DB", "database_name": "frameline", "database_id": "32bf8f23-7594-4c5f-8e7a-51b5eed336a7", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "frameline-media" }],
      "kv_namespaces": [{ "binding": "KV", "id": "e672b1baa531411a90176fa35a293291" }],
      "queues": {
        "producers": [{ "binding": "PHOTO_QUEUE", "queue": "frameline-photos" }],
        "consumers": [{ "queue": "frameline-photos", "max_batch_size": 10, "max_batch_timeout": 2, "max_retries": 5, "dead_letter_queue": "frameline-photos-dlq" }]
      },
      "durable_objects": {
        "bindings": [
          { "name": "EVENT_HUB", "class_name": "EventHub" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
        ]
      },
      "vectorize": [{ "binding": "FACES", "index_name": "frameline-faces" }],
      "ratelimits": [
        { "name": "RL_GLOBAL", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
        { "name": "RL_PUBLIC", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
}
