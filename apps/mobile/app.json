{
  "expo": {
    "name": "Frameline",
    "slug": "frameline",
    "scheme": "frameline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF7F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.frameline.app",
      "associatedDomains": [
        "applinks:frameline.in"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Frameline uses the camera to scan event QR codes and take the selfie that finds your photos.",
        "NSPhotoLibraryUsageDescription": "Frameline needs your photo library to upload photos to your events.",
        "NSPhotoLibraryAddUsageDescription": "Frameline saves photos you download to your library."
      }
    },
    "android": {
      "package": "in.frameline.app",
      "adaptiveIcon": {
        "backgroundColor": "#15120E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "frameline.in"
            },
            {
              "scheme": "https",
              "host": "www.frameline.in"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0C0A08"
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Frameline uses the camera to scan event QR codes and take the selfie that finds your photos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Frameline needs your photo library to upload photos to your events.",
          "cameraPermission": "Frameline uses the camera for the selfie that finds your photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Frameline needs access to save the photos you download.",
          "savePhotosPermission": "Frameline saves photos you download to your library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
