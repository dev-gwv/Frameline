{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // Runs directly under Node (no bundler): relative imports use explicit .ts/.mjs extensions throughout.
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src", "scripts"]
}
