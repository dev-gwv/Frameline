# Copy to .env for local dev (never commit .env).
PORT=8788

# Must match the PROCESSOR_TOKEN secret set on the Worker (apps/api): wrangler secret put PROCESSOR_TOKEN
PROCESSOR_TOKEN=dev-only-change-me

# R2 S3-compatible credentials (Cloudflare dashboard → R2 → Manage API tokens). These are the PROCESSOR's own
# credentials, separate from apps/api's optional R2_ACCESS_KEY_ID (that one is for browser direct-to-R2
# presigned uploads, which we deliberately don't use — see docs/DEPLOYMENT.md). Scope this token to Object
# Read & Write on the frameline-media bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
